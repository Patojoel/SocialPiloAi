# Frontend
VITE_API_URL=http://localhost:3000
VITE_APP_ENV=development

# Backend
NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:5173
DATABASE_HOST=localhost
DATABASE_PORT=5435  # Docker host port (container: 5432)
DATABASE_USER=socialpilot
DATABASE_PASSWORD=socialpilot
DATABASE_NAME=socialpilot_db
JWT_SECRET=change-me-in-production-min-32-chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars
JWT_REFRESH_EXPIRES_IN=7d
EMAIL_PROVIDER=resend
RESEND_API_KEY=re_your-resend-key
EMAIL_FROM=noreply@socialpilot.ai
REDIS_URL=redis://localhost:6380  # Docker host port (container: 6379)
